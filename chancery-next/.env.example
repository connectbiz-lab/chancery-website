# Copy to .env.local for local work. Production values live in Vercel
# (Project → Settings → Environment Variables); never commit real values.

# Supabase — publishable keys (safe in the browser; RLS governs access) and the
# service-role key (server only, secret).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The ONE canonical origin every canonical tag, sitemap URL, schema @id and
# /llms.txt link is built on (lib/seo.ts). Unset, the code falls back to
# https://www.chanceryhotels.com — set it explicitly in Production once the
# hotel has chosen www vs the bare host.
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 measurement id (G-XXXXXXXXXX). PRODUCTION ONLY, so
# previews don't report into the live property (components/GoogleAnalytics.tsx).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Search Console / Bing Webmaster meta-tag verification codes (the content="…"
# value only). Not needed for a Search Console DOMAIN property (DNS-verified).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# IndexNow (lib/indexnow.ts). The key is served at /<key>.txt to prove the site
# owns its pings: 8–128 characters of a-z, A-Z, 0-9 and "-" — e.g. the output
# of `openssl rand -hex 16`. Public by design once served. Changing it takes a
# redeploy. Production and Preview.
INDEXNOW_KEY=
# Guards POST /api/indexnow. Secret: Production only, and the same value as the
# GitHub Actions secret INDEXNOW_PING_SECRET. Generate once and pipe it to both
# `gh secret set` and `vercel env add` — never print it.
INDEXNOW_PING_SECRET=

# Enquiry email (lib/email) — Resend key and sender name, the address used when
# no department matches, and the secret Vercel Cron sends to /api/cron/*.
RESEND_API_KEY=
EMAIL_FROM_NAME=
NOTIFY_FALLBACK_EMAIL=
CRON_SECRET=
