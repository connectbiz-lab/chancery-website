 {
  "op": "update",
  "table": "hotel",
  "match": {
   "slug": "chancery"
  },
  "set": {
   "intro_body": "The Chancery, a contemporary boutique business hotel on Lavelle Road, combines classic character with modern comfort. Close to MG Road, UB City and Cubbon Park, it offers 126 Deluxe and Premium Rooms and Executive Suites, along with 6,800 sq. ft. of banquet space. Guests can enjoy round-the-clock dining at South Parade, authentic Japanese cuisine at Matsuri, and spa experiences at Sara Spa. Through its partnership with Toyota Enterprises, the hotel also offers Japanese hospitality experiences across its rooms, restaurant and spa."
  }
 },
 {
  "op": "update",
  "table": "page",
  "match": {
   "kind": "events",
   "hotel": "chancery"
  },
  "set": {
   "intro_body": "Five venues to choose from — the Lavelle Hall for receptions of up to 200 guests, the Business Centre for boardroom meetings, and three halls in between — each with modern facilities and a dedicated events team to run the day."
  }
 }
